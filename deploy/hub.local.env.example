# Local-only deployment overlay (gitignored as deploy/hub.local.env).
# Keep localhost bind always active; add extra interfaces here when needed.

# Required by the production auth_mode=enforce profile. Generate a unique value with:
#   openssl rand -hex 32
# MCP_HUB_REGISTER_TOKEN=replace-with-generated-secret

# Single extra bind (VPN interface example):
# MCP_HUB_EXTRA_BIND_HOSTS=100.107.1.68
# MCP_HUB_PUBLIC_BASE_URL=http://100.107.1.68:3000
# MCP_HUB_ALLOWED_ORIGINS=http://100.107.1.68:3000

# Multiple extra binds (comma-separated):
# MCP_HUB_EXTRA_BIND_HOSTS=100.107.1.68,192.168.1.50
